# Server-side AI provider (optional; mock adapter is used without these)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Payment provider (optional; mock sandbox is used without these)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=

# Hosted bindings are provisioned by Sites
DB_BINDING=DB
FILES_BINDING=FILES

# Optional: enables real customer message and voice analysis in New Job.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5.6-sol
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
